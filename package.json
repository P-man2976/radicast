{
	"name": "radicast",
	"description": "Convert Radiko / NHK radio to mp3 HTTP streaming",
	"version": "1.0.8",
	"homepage": "https://github.com/p-man2976/radicast",
	"repository": {
		"type": "git",
		"url": "https://github.com/p-man2976/radicast.git"
	},
	"keywords": [
		"radio",
		"radiko",
		"nhk"
	],
	"exports": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"bin": {
		"radicast": "./dist/cli/index.js"
	},
	"type": "module",
	"license": "MIT",
	"scripts": {
		"dev": "tsup --watch --onSuccess \"node dist/cli/index.js\"",
		"build": "tsc",
		"start": "node dist/cli/index.js",
		"prepack": "yarn build"
	},
	"devDependencies": {
		"@types/fluent-ffmpeg": "^2.1.26",
		"@types/node": "^22.7.5",
		"@types/yargs": "^17.0.33",
		"tsup": "^8.3.0",
		"typescript": "^5.6.2"
	},
	"dependencies": {
		"@hono/node-server": "^1.13.1",
		"@hono/zod-validator": "^0.4.1",
		"fast-xml-parser": "^4.5.0",
		"fluent-ffmpeg": "^2.1.3",
		"hono": "^4.6.3",
		"m3u8-parser": "^7.2.0",
		"yargs": "^17.7.2",
		"zod": "^3.23.8"
	}
}
